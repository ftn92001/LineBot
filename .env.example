# ===== LineBot .env 範例 =====
# 複製這份檔案並更名為 .env，填入你自己的金鑰
# cp .env.example .env
#
# 用不到的功能可以把金鑰留空，但 LINE BOT 一定要填，bot 才連得上
# LINE 相關的金鑰請到 LINE Developers Console https://developers.line.biz/ 的你的專案取得
# （Channel Access Token 與 Channel Secret）

# Django
SECRET_KEY=change-me-to-a-long-random-string

# ===== MySQL（DBeaver / bot 共用，請改強密碼）=====
MYSQL_ROOT_PASSWORD=strong-password-here
MYSQL_DATABASE=LineBot

# ===== LINE BOT（必填）=====
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ===== 其它功能（選填，沒用就留空）=====
YOUTUBE_API_KEY=
WEATHER_API_KEY=
OPEN_AI_API_KEY=
GIPHY_API_KEY=
GEMINI_API_KEY=

# ===== 連線設定（docker-compose 內已透過 environment 設定，一般不用改）=====
# REDIS_LOCATION=redis://redis:6379/0
# REDIS_PASSWORD=
# DATABASE_PATH=
